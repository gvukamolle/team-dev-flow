{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team.local/schemas/team-dev-flow/task-contract/v1",
  "title": "Team Dev Flow Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticket",
    "jira_revision",
    "goal",
    "in_scope",
    "out_of_scope",
    "acceptance_criteria",
    "repositories",
    "dependencies",
    "constraints",
    "risk",
    "required_validation",
    "approval_boundaries",
    "open_questions",
    "contract_hash"
  ],
  "properties": {
    "schema_version": {"const": "team-dev-flow/task-contract/v1"},
    "ticket": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"},
    "jira_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["updated", "content_hash"],
      "properties": {
        "updated": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "goal": {"type": "string", "minLength": 1},
    "business_outcome": {"type": "string"},
    "in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[0-9]{2,}$"},
          "text": {"type": "string", "minLength": 1},
          "verification": {"type": "string", "minLength": 1}
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "ownership"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "ownership": {"enum": ["primary", "read_only_context", "external_team"]}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "status"],
        "properties": {
          "kind": {"enum": ["blocks", "is_blocked_by", "related", "generated", "external"]},
          "reference": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "satisfied", "unknown", "not_applicable"]},
          "note": {"type": "string"}
        }
      }
    },
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["normal", "high", "critical"]},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "required_validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

