{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team.local/schemas/team-dev-flow/review-disposition/v1",
  "title": "Team Dev Flow Review Finding Disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "severity", "scope", "status", "resolution"],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^REV-[0-9]{3,}$"},
    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
    "scope": {"enum": ["in_scope", "adjacent", "out_of_scope"]},
    "status": {"enum": ["accepted", "rejected_with_reason", "needs_evidence", "deferred", "duplicate"]},
    "resolution": {"type": "string", "minLength": 1},
    "resolution_sha": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "follow_up_ticket": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"},
    "follow_up_ref": {"type": "string", "pattern": "^[a-z][a-z0-9+._-]*:[^\\s:]+:.+$"},
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "needs_evidence"}}
      },
      "then": {"required": ["disagreement"]}
    }
  ]
}
