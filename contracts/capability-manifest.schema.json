{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team.local/schemas/team-dev-flow/capability-manifest/v1",
  "title": "Team Dev Flow adapter capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "adapter_kind", "provider", "instance", "version", "status", "capabilities"],
  "properties": {
    "schema_version": {"const": "team-dev-flow/capability-manifest/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "adapter_kind": {"enum": ["agent_host", "task_store", "git_provider"]},
    "provider": {"type": "string", "minLength": 1},
    "instance": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["supported", "experimental", "planned", "unavailable"]},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mode", "enabled"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
          "mode": {"enum": ["read", "preview", "write"]},
          "enabled": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
