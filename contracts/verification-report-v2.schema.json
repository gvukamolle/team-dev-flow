{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team.local/schemas/team-dev-flow/verification-report/v2",
  "title": "Team Dev Flow provider-neutral Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_ref", "contract_hash", "source_revision", "verified_sha", "verifier", "independent_from_builder", "environment", "checks", "unverified", "result"],
  "properties": {
    "schema_version": {"const": "team-dev-flow/verification-report/v2"},
    "scope_ref": {"type": "string", "pattern": "^[a-z][a-z0-9+._-]*:[^\\s:]+:.+$"},
    "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_revision": {
      "type": "object", "additionalProperties": false, "required": ["updated", "content_hash"],
      "properties": {
        "updated": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "verified_sha": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "verifier": {"type": "string", "minLength": 1},
    "independent_from_builder": {"const": true},
    "environment": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "command_or_method", "result", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command_or_method": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "not_run"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "unverified": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "result": {"enum": ["PASS", "FAIL", "INCOMPLETE"]}
  }
}
